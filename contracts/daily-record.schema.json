{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluba-anticipa.local/contracts/daily-record.schema.json",
  "title": "DailyRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "recorded_at", "context", "observations"],
  "properties": {
    "subject_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "context": {"type": "string", "enum": ["family", "school", "professional"]},
    "source_actor_id": {"type": ["string", "null"]},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_key", "status"],
        "properties": {
          "feature_key": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["observed", "unknown"]},
          "value": {"type": ["string", "number", "boolean", "null"]},
          "note": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "unknown"}}},
            "then": {"properties": {"value": {"type": "null"}}}
          }
        ]
      }
    },
    "source": {
      "type": "string",
      "enum": ["form", "text_confirmed", "voice_confirmed", "import"]
    }
  }
}
