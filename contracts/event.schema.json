{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluba-anticipa.local/contracts/event.schema.json",
  "title": "DysregulationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "subject_id", "occurred_at", "event_type", "context"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "const": "dysregulation"},
    "context": {"type": "string", "enum": ["family", "school", "professional", "other"]},
    "severity": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "trigger_notes": {"type": ["string", "null"]},
    "strategy_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outcome": {"type": ["string", "null"], "enum": ["regulated", "partial", "no_effect", "unknown", null]}
  }
}
