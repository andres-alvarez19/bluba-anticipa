{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluba-anticipa.local/contracts/prediction.schema.json",
  "title": "Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "prediction_timestamp",
    "horizon_hours",
    "status",
    "risk",
    "confidence",
    "data_quality",
    "top_factors",
    "recommendations",
    "insufficiency_reasons"
  ],
  "properties": {
    "subject_id": {"type": "string", "minLength": 1},
    "prediction_timestamp": {"type": "string", "format": "date-time"},
    "horizon_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "status": {"type": "string", "enum": ["available", "insufficient_data"]},
    "risk": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "level"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "level": {"type": "string", "enum": ["low", "medium", "high"]}
          }
        }
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "level": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "missing_features", "stale_features", "source_coverage"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "stale_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "school", "professional"],
          "properties": {
            "family": {"type": "boolean"},
            "school": {"type": "boolean"},
            "professional": {"type": "boolean"}
          }
        }
      }
    },
    "top_factors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_key", "label", "direction", "importance"],
        "properties": {
          "feature_key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "enum": ["risk_increase", "risk_decrease", "context_only"]},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "observation": {"type": ["string", "null"]},
          "baseline_reference": {"type": ["string", "null"]}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {"$ref": "recommendation.schema.json"}
    },
    "insufficiency_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"properties": {"risk": {"type": "object"}}}
    },
    {
      "if": {"properties": {"status": {"const": "insufficient_data"}}},
      "then": {"properties": {"risk": {"type": "null"}}}
    }
  ]
}
